PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=event_ticketing
DB_USER=postgres
DB_PASSWORD=yourpassword

# JWT
JWT_SECRET=your_super_secret_key_change_this
JWT_EXPIRES_IN=7d

# T-17: public showtime pages are cached for 30 seconds
REDIS_URL=redis://localhost:6379
# Holds: TTL defaults to 600 seconds; cleanup runs immediately, then every 30s.
SEAT_HOLD_TTL_SECONDS=600
SEAT_HOLD_CLEANUP_INTERVAL_MS=30000

# SCRUM-212 (S-21 / T-48, T-49): Webhook HMAC-SHA256 signature secret
PAYMENT_WEBHOOK_SECRET=mock-secret
MOCK_GATEWAY_SECRET=mock-secret

# T-40: MoMo sandbox. Keep credentials on the backend only.
PAYMENT_PROVIDER=momo
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_BASE_URL=https://test-payment.momo.vn
MOMO_REDIRECT_URL=http://localhost:5173/payment/return
# MoMo needs a publicly reachable callback URL; use an HTTPS tunnel for local testing.
MOMO_IPN_URL=https://your-public-host/api/payments/momo/webhook
