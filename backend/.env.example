PORT=3000
NODE_ENV=development
DEPLOY_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=event_ticketing
DB_USER=postgres
DB_PASSWORD=yourpassword

# JWT
JWT_SECRET=your_super_secret_key_change_this
JWT_EXPIRES_IN=7d

# T-17: public showtime pages are cached for 30 seconds
REDIS_URL=redis://localhost:6379
# Holds: TTL defaults to 600 seconds; cleanup runs immediately, then every 30s.
SEAT_HOLD_TTL_SECONDS=600
SEAT_HOLD_CLEANUP_INTERVAL_MS=30000

# T-44: choose exactly one gateway. Mock requires a server-side secret.
PAYMENT_PROVIDER=
MOCK_PAYMENT_WEBHOOK_SECRET=
MOCK_PAYMENT_PUBLIC_ORIGIN=http://localhost:3000
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_BASE_URL=https://test-payment.momo.vn
MOMO_REDIRECT_URL=http://localhost:5173/payment/return
# MoMo needs a publicly reachable callback URL; use an HTTPS tunnel for local testing.
MOMO_IPN_URL=https://your-public-host/api/payments/momo/webhook
# T-52: overdue pending orders expire at startup, then every minute.
ORDER_EXPIRY_CLEANUP_INTERVAL_MS=60000

# S-21 / T-49: đặt 1 khi backend chạy sau đúng một reverse proxy (Nginx). Để trống khi chạy trực tiếp,
# nếu không người gửi có thể tự khai IP qua X-Forwarded-For.
TRUST_PROXY=

# S-26: khoá HMAC ký mã QR trên vé, tối thiểu 32 ký tự, chỉ để ở backend.
# Để trống thì dẫn xuất khoá riêng từ JWT_SECRET. Đổi khoá thì mọi QR đã phát hết hiệu lực.
TICKET_QR_SECRET=
