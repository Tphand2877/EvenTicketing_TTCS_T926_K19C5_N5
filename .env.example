POSTGRES_DB=eventticketing
POSTGRES_USER=eventticketing
POSTGRES_PASSWORD=replace_with_a_strong_password
FRONTEND_URL=http://localhost:8080
JWT_SECRET=replace_with_a_long_random_secret
REDIS_URL=redis://redis:6379
SEAT_HOLD_TTL_SECONDS=600
SEAT_HOLD_CLEANUP_INTERVAL_MS=30000
PAYMENT_WEBHOOK_SECRET=replace_with_a_long_random_secret

# T-40: MoMo sandbox credentials are passed only to the backend container.
PAYMENT_PROVIDER=momo
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_BASE_URL=https://test-payment.momo.vn
MOMO_REDIRECT_URL=http://localhost:8080/payment/return
# MoMo needs a publicly reachable callback URL; use an HTTPS tunnel for local testing.
MOMO_IPN_URL=https://your-public-host/api/payments/momo/webhook
# T-52: overdue pending orders expire at startup, then every minute.
ORDER_EXPIRY_CLEANUP_INTERVAL_MS=60000
